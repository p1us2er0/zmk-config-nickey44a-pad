/*
 * Based on the tomkey keymap (p1us2er0/tomkey config/tomkey.keymap).
 *
 * Key positions differ: tomkey has an inner column and a bottom row, the
 * Nickey44A-PAD has an outer column instead. Positions 30 (right of B) and
 * 31 (left of N) are covered by the trackpads and have no switch, so they
 * are &none. 42 keys are left. Moved keys:
 *   tomkey bottom row Cmd / Opt / Ctrl -> left outer column bottom / top / middle
 *   tomkey inner ;/FUNCTION            -> right outer column top (11)
 *   tomkey inner -/Shift               -> right thumb outer (43)
 *   tomkey inner '                     -> right home row, pinky (22)
 *   tomkey bottom right Del            -> right bottom row, pinky (36)
 *   tomkey pinky F2 / F7               -> right outer column middle / bottom (23 / 37)
 *                                         (FUNCTION keeps F10 and &win_jis in place)
 *   tomkey inner Ctrl+Space            -> combo F + G
 *   tomkey combo ' + H for `           -> J + K
 *
 * Layer numbers differ from tomkey. nickey44a_r.overlay refers to layers
 * by number, so keep these in step with it: MOUSE_SLOW (1) slows the right
 * trackpad, turns its two-finger left/right swipes into Back/Forward and
 * its two-finger tap into the zoom reset,
 * WIN (2) and IPAD (4) pick the host's swipe keys, NUM (5)
 * turns the right pad's swipes into the app switcher,
 * and touching the pad enters AUTO_MOUSE (8). The rgbled colors in
 * nickey44a_r.conf are per layer number too.
 *
 * WIN, WIN_JIS and IPAD are host flags, set by the Bluetooth profile keys
 * on FUNCTION, and at startup for the saved profile by profile_layers below
 * (src/profile_layers.c). WIN is on for both Windows profiles; WIN_JIS is
 * on as well for the JIS one and only holds the keys whose symbols move on
 * JIS. They sit below NUM so that NUM's keys win over the WIN_JIS keys, and
 * keys that differ by host choose their binding with layer morphs
 * (zmk,behavior-layer-morph) instead of separate layers.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>  // &ind_bat: FUNCTION + Q shows the battery levels

#define LAYER_MAC 0
#define LAYER_MOUSE_SLOW 1
#define LAYER_WIN 2
#define LAYER_WIN_JIS 3
#define LAYER_IPAD 4
#define LAYER_NUM 5
#define LAYER_FUNCTION 6
#define LAYER_MOUSE 7
#define LAYER_AUTO_MOUSE 8

#define ZKHK_JIS                  GRAVE                  // Zenkaku ↔ Hankaku ↔ Kanji (半角 ↔ 全角 ↔ 漢字)
#define MINUS_JIS                 MINUS                  // -
#define CARET_JIS                 EQUAL                  // ^
#define YEN_JIS                   INT3                   // ¥
#define AT_SIGN_JIS               LBKT                   // @
#define LEFT_BRACKET_JIS          RBKT                   // [
#define EISU_JIS                  CAPS                   // Eisū (英数)
#define SEMI_JIS                  SEMI                   // ;
#define COLON_JIS                 SQT                    // :
#define RIGHT_BRACKET_JIS         NUHS                   // ]
#define COMMA_JIS                 COMMA                  // ,
#define DOT_JIS                   DOT                    // .
#define SLASH_JIS                 SLASH                  // /
#define BACKSLASH_JIS             INT1                   // (backslash)
#define MHEN_JIS                  INT5                   // Muhenkan (無変換)
#define HENK_JIS                  INT4                   // Henkan (変換)
#define KANA_JIS                  INT2                   // Katakana ↔ Hiragana ↔ Rōmaji (カタカナ ↔ ひらがな ↔ ローマ字)
#define EXCLAMATION_JIS           LS(N1)                 // !
#define DOUBLE_QUOTE_JIS          LS(N2)                 // "
#define HASH_JIS                  LS(N3)                 // #
#define DOLLAR_JIS                LS(N4)                 // $
#define PERCENT_JIS               LS(N5)                 // %
#define AMPERSAND_JIS             LS(N6)                 // &
#define SINGLE_QUOTE_JIS          LS(N7)                 // '
#define LEFT_PARENTHESIS_JIS      LS(N8)                 // (
#define RIGHT_PARENTHESIS_JIS     LS(N9)                 // )
#define EQUAL_JIS                 LS(MINUS_JIS)          // =
#define TILDE_JIS                 LS(CARET_JIS)          // ~
#define PIPE_JIS                  LS(YEN_JIS)            // |
#define GRAVE_JIS                 LS(AT_SIGN_JIS)        // `
#define LEFT_BRACE_JIS            LS(LEFT_BRACKET_JIS)   // {
#define CAPS_JIS                  LS(EISU_JIS)           // Caps Lock
#define PLUS_JIS                  LS(SEMI_JIS)           // +
#define ASTERISK_JIS              LS(COLON_JIS)          // *
#define RIGHT_BRACE_JIS           LS(RIGHT_BRACKET_JIS)  // }
#define LT_JIS                    LS(COMMA_JIS)          // <
#define RT_JIS                    LS(DOT_JIS)            // >
#define QUESTION_JIS              LS(SLASH_JIS)          // ?
#define UNDER_JIS                 LS(BACKSLASH_JIS)      // _

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <500>;
};

/*
 * Same as tomkey (where this is in tomkey_L.overlay): do not enter the auto
 * mouse layer within 300 ms of a key press, and leave it at once on any key
 * other than the modifiers (Opt 0, Ctrl 12, Cmd 24, Z/Shift 25) and the
 * thumb keys used in AUTO_MOUSE (Space 39, LANG1 40, Enter 42, -/Shift 43).
 * Backspace (41) types and leaves, like the other keys.
 */
&zip_temp_layer {
    require-prior-idle-ms = <300>;
    excluded-positions = <0 12 24 25 39 40 42 43>;
};

&mkp_input_listener { input-processors = <&zip_temp_layer LAYER_AUTO_MOUSE 500>; };

/ {
    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 15>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <13 14>;
        };

        // tomkey has Ctrl+Space on the inner key right of G, on the base
        // layer only (&trans elsewhere), so this combo works on every layer.
        ctrl_space {
            bindings = <&kp LC(SPACE)>;
            key-positions = <16 17>;
        };

        // These pick the key for the host with layer morphs (&os_comment and
        // the others), on the base layers and NUM.
        comment {
            bindings = <&os_comment>;
            key-positions = <15 16>;
            layers = <LAYER_MAC LAYER_WIN LAYER_WIN_JIS LAYER_IPAD LAYER_NUM>;
        };

        back_quote {
            bindings = <&os_grave>;
            key-positions = <19 20>;
            layers = <LAYER_MAC LAYER_WIN LAYER_WIN_JIS LAYER_IPAD LAYER_NUM>;
        };

        equal {
            bindings = <&os_equal>;
            key-positions = <18 19>;
            layers = <LAYER_MAC LAYER_WIN LAYER_WIN_JIS LAYER_IPAD LAYER_NUM>;
        };

        back {
            bindings = <&kp LG(LEFT_ARROW)>;
            key-positions = <25 26>;
            layers = <LAYER_MAC LAYER_IPAD>;
        };

        next {
            bindings = <&kp LG(RIGHT_ARROW)>;
            key-positions = <26 27>;
            layers = <LAYER_MAC LAYER_IPAD>;
        };

        back_win {
            bindings = <&kp LA(LEFT_ARROW)>;
            key-positions = <25 26>;
            layers = <LAYER_WIN LAYER_WIN_JIS>;
        };

        next_win {
            bindings = <&kp LA(RIGHT_ARROW)>;
            key-positions = <26 27>;
            layers = <LAYER_WIN LAYER_WIN_JIS>;
        };
    };

    // Host flags by Bluetooth profile (src/profile_layers.c): set at startup
    // for the saved profile and on each profile change. The profile keys on
    // FUNCTION set the same layers themselves too, because ZMK raises no
    // event when the active profile is selected again.
    profile_layers {
        compatible = "zmk,profile-layers";
        layers = <LAYER_WIN LAYER_WIN_JIS LAYER_IPAD>;

        ipad {
            profile = <2>;
            layers = <LAYER_IPAD>;
        };

        windows {
            profile = <3>;
            layers = <LAYER_WIN>;
        };

        windows_jis {
            profile = <4>;
            layers = <LAYER_WIN LAYER_WIN_JIS>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // F19 asks the Mac to take the monitor back once the keyboard has
        // switched to it. ZMK keeps the other hosts connected, so the Mac
        // cannot tell from Bluetooth alone which host is in use.
        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&mac_us &macro_wait_time 300 &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER &kp F19>;
            label = "BT_MAC";
        };

        // F18 asks the Mac to hand the monitor over to Windows before the
        // keyboard leaves it. The wait lets the release reach the Mac before
        // the profile switch.
        bt_win: bt_win {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_wait_time 200 &kp F18 &macro_wait_time 15 &win_us &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
            label = "BT_WIN";
        };

        bt_win_jis: bt_win_jis {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_wait_time 200 &kp F18 &macro_wait_time 15 &win_jis &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
            label = "BT_WIN_JIS";
        };

        // Keyboard-only versions: switch the profile but leave the monitor
        // where it is (no F18/F19). BT1 uses &bt_mac_kbd on a single tap: it
        // is a Mac without the monitor.
        bt_mac_kbd: bt_mac_kbd {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&mac_us &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
            label = "BT_MAC_KBD";
        };

        bt_win_kbd: bt_win_kbd {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&win_us &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
            label = "BT_WIN_KBD";
        };

        bt_win_jis_kbd: bt_win_jis_kbd {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&win_jis &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
            label = "BT_WIN_JIS_KBD";
        };

        // The iPad has no monitor to hand over, so no F18/F19.
        bt_ipad: bt_ipad {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&ipad &macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
            label = "BT_IPAD";
        };

        mac_us: mac_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog_off LAYER_WIN &tog_off LAYER_WIN_JIS &tog_off LAYER_IPAD>;
            label = "MAC_US";
        };

        win_us: win_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog_on LAYER_WIN &tog_off LAYER_WIN_JIS &tog_off LAYER_IPAD>;
            label = "WIN_US";
        };

        win_jis: win_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog_on LAYER_WIN &tog_on LAYER_WIN_JIS &tog_off LAYER_IPAD>;
            label = "WIN_JIS";
        };

        // The iPad takes the Mac keys; IPAD picks its swipes and MOUSE keys.
        ipad: ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog_off LAYER_WIN &tog_off LAYER_WIN_JIS &tog_on LAYER_IPAD>;
            label = "IPAD";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
        };

        td_comma_left_parenthesis: td_comma_left_parenthesis {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA_LEFT_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LEFT_PARENTHESIS>;
        };

        td_dot_right_parenthesis: td_dot_right_parenthesis {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DOT_RIGHT_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp RIGHT_PARENTHESIS>;
        };

        single_quote_jis: single_quote_jis {
            compatible = "zmk,behavior-mod-morph";
            label = "SINGLE_QUOTE_JIS";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE_JIS>, <&kp DOUBLE_QUOTE_JIS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        equal_jis: equal_jis {
            compatible = "zmk,behavior-mod-morph";
            label = "EQUAL_JIS";
            #binding-cells = <0>;
            bindings = <&kp EQUAL_JIS>, <&kp PLUS_JIS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_jis: minus_jis {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_JIS";
            #binding-cells = <0>;
            bindings = <&kp MINUS_JIS>, <&kp UNDER_JIS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        semi_jis: semi_jis {
            compatible = "zmk,behavior-mod-morph";
            label = "SEMI_JIS";
            #binding-cells = <0>;
            bindings = <&kp SEMI_JIS>, <&kp COLON_JIS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mt_minus_jis: mt_minus_jis {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_MINUS_JIS";
            bindings = <&kp>, <&minus_jis>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
        };

        lt_semi_jis: lt_semi_jis {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SEMI_JIS";
            bindings = <&mo>, <&semi_jis>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
        };

        td_comma_left_parenthesis_jis: td_comma_left_parenthesis_jis {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA_LEFT_PARENTHESIS_JIS";
            #binding-cells = <0>;
            bindings = <&kp COMMA_JIS>, <&kp LEFT_PARENTHESIS_JIS>;
        };

        td_dot_right_parenthesis_jis: td_dot_right_parenthesis_jis {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DOT_RIGHT_PARENTHESIS_JIS";
            #binding-cells = <0>;
            bindings = <&kp DOT_JIS>, <&kp RIGHT_PARENTHESIS_JIS>;
        };

        // Profile keys: a single tap switches the keyboard and the monitor, a
        // double tap switches only the keyboard (to work on the Mac's built-in
        // display, or on the Windows PC's own screen, for a moment). A single
        // tap waits out the tapping term before it acts.
        td_bt_mac_0: td_bt_mac_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT_MAC_0";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&bt_mac 0>, <&bt_mac_kbd 0>;
        };

        td_bt_win_3: td_bt_win_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT_WIN_3";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&bt_win 3>, <&bt_win_kbd 3>;
        };

        td_bt_win_jis_4: td_bt_win_jis_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT_WIN_JIS_4";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&bt_win_jis 4>, <&bt_win_jis_kbd 4>;
        };

        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_ON";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        /*
         * Turns both halves off: FUNCTION + left outer top (0), held for 1 s
         * and released. Unlike &soft_off, the left half also waits for the
         * release, which reaches the right half only while the left half is
         * on. No key wakes them, so pressure in a carrying case cannot: turn
         * each half's power switch off and on (or press its reset button).
         * The RGB LED goes off too (src/soft_off_leds.c). The node name stays
         * within the 8 characters that the split link allows for a behavior
         * name.
         */
        soft_off_hold: so_hold {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;
            hold-time-ms = <1000>;
        };

        /*
         * MOUSE keys that do the same thing on the Mac and on Windows: the
         * first binding is for the Mac, the second for WIN and WIN_JIS (on
         * while a Windows profile is selected). See src/behavior_layer_morph.c.
         */
        doc_top: doc_top {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(UP_ARROW)>, <&kp LC(HOME)>;
            layers = <LAYER_WIN>;
        };

        doc_bottom: doc_bottom {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(DOWN_ARROW)>, <&kp LC(END)>;
            layers = <LAYER_WIN>;
        };

        // Virtual desktops, as with a two-finger left/right swipe on the left pad.
        desk_left_mw: desk_left_mw {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT_ARROW)>, <&kp LG(LC(LEFT_ARROW))>;
            layers = <LAYER_WIN>;
        };

        desk_right_mw: desk_right_mw {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(RIGHT_ARROW)>, <&kp LG(LC(RIGHT_ARROW))>;
            layers = <LAYER_WIN>;
        };

        // The iPad has no desktops: C goes to the Home Screen, V to the last app.
        desk_left: desk_left {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&desk_left_mw>, <&kp LG(H)>;
            layers = <LAYER_IPAD>;
        };

        desk_right: desk_right {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&desk_right_mw>, <&kp LG(TAB)>;
            layers = <LAYER_IPAD>;
        };

        // Combos: comment out (Cmd+/ or Ctrl+/), ` and =.
        os_comment: os_comment {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(SLASH)>, <&kp LC(SLASH)>;
            layers = <LAYER_WIN>;
        };

        os_grave: os_grave {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp GRAVE_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        os_equal: os_equal {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&equal_jis>;
            layers = <LAYER_WIN_JIS>;
        };

        /*
         * NUM symbols on a different key on a JIS host: the first binding is
         * for US hosts, the second for WIN_JIS. The other NUM keys are the
         * same on both.
         */
        sym_at: sym_at {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp AT_SIGN>, <&kp AT_SIGN_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_caret: sym_caret {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp CARET>, <&kp CARET_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_amps: sym_amps {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp AMPERSAND>, <&kp AMPERSAND_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_lbrc: sym_lbrc {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp LEFT_BRACE_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_rbrc: sym_rbrc {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACE>, <&kp RIGHT_BRACE_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_bsls: sym_bsls {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp BACKSLASH_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_pipe: sym_pipe {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp PIPE>, <&kp PIPE_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_tilde: sym_tilde {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp TILDE>, <&kp TILDE_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_star: sym_star {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp ASTERISK>, <&kp ASTERISK_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_lbkt: sym_lbkt {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACKET_JIS>;
            layers = <LAYER_WIN_JIS>;
        };

        sym_rbkt: sym_rbkt {
            compatible = "zmk,behavior-layer-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACKET_JIS>;
            layers = <LAYER_WIN_JIS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAC {
            bindings = <
&kp LEFT_ALT      &kp Q             &kp W  &kp E  &kp R                &kp T                                              &kp Y      &kp U                  &kp I                       &kp O                      &kp P             &lt LAYER_FUNCTION SEMI
&kp LEFT_CONTROL  &kp A             &kp S  &kp D  &kp F                &kp G                                              &kp H      &kp J                  &kp K                       &kp L                      &kp SINGLE_QUOTE  &kp F2
&kp LEFT_GUI      &mt LEFT_SHIFT Z  &kp X  &kp C  &kp V                &kp B      &none                    &none          &kp N      &kp M                  &td_comma_left_parenthesis  &td_dot_right_parenthesis  &kp DELETE        &kp F7
                                                  &lt LAYER_NUM LANG2  &kp SPACE  &lt LAYER_MOUSE LANG1    &kp BACKSPACE  &kp ENTER  &mt RIGHT_SHIFT MINUS
            >;
        };

        // Layer 1. Only a switch for nickey44a_r.overlay: while it is active
        // the right trackpad moves at 2/3 speed and its two-finger left/right
        // swipes go back and forward. Entered with Space in MOUSE and AUTO_MOUSE, like
        // MOUSE_SLOW on tomkey.
        MOUSE_SLOW {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        WIN {
            bindings = <
&trans            &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_WIN      &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_CONTROL  &trans  &trans  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        // Layer 3. On together with WIN for the JIS Windows profile (BT4), so
        // WIN gives it Win and Ctrl; this only has the keys whose symbols move
        // on JIS. The NUM symbols that move are layer morphs on NUM.
        WIN_JIS {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans                      &trans                          &trans                         &trans             &lt_semi_jis LAYER_FUNCTION 0
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans                      &trans                          &trans                         &single_quote_jis  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none     &none   &trans  &trans                      &td_comma_left_parenthesis_jis  &td_dot_right_parenthesis_jis  &trans             &trans
                                &trans  &trans  &trans    &trans  &trans  &mt_minus_jis LEFT_SHIFT 0
            >;
        };

        // Layer 4. Only a flag for the iPad (BT2), like WIN for Windows:
        // nickey44a_r.overlay and the MOUSE keys C and V check it. Set with
        // the other host flags (profile_layers and the profile keys).
        IPAD {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        NUM {
            bindings = <
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                         &kp NUMBER_6  &kp N7     &kp N8     &kp N9     &kp N0  &trans
&trans  &kp EXCLAMATION  &sym_at       &kp HASH      &kp DOLLAR    &kp PERCENT                    &sym_caret    &sym_amps  &sym_lbrc  &sym_rbrc  &trans  &trans
&trans  &trans           &kp SLASH     &sym_bsls     &sym_pipe     &sym_tilde   &none     &none   &kp QUESTION  &sym_star  &sym_lbkt  &sym_rbkt  &trans  &trans
                                                     &trans        &trans       &trans    &trans  &trans        &trans
            >;
        };

        FUNCTION {
            bindings = <
&soft_off_hold  &ind_bat  &trans   &trans  &sys_reset  &bootloader                                    &td_bt_mac_0  &bt_mac_kbd 1  &bt_ipad 2  &td_bt_win_3  &td_bt_win_jis_4  &trans
&trans          &kp F1    &kp F2   &kp F3  &kp F4      &kp F5                                         &kp F6        &kp F7         &kp F8      &kp F9        &kp F10           &trans
&trans          &kp F11   &kp F12  &trans  &trans      &kp LG(LS(S))  &none                   &none   &bootloader   &sys_reset     &mac_us     &win_us       &win_jis          &bt BT_CLR
                                           &trans      &trans         &kp LG(LS(NUMBER_4))    &trans  &trans        &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &kp HOME        &doc_top        &kp UP_ARROW    &doc_bottom      &trans                                     &trans     &kp LS(LC(TAB))  &kp LC(TAB)  &trans  &trans  &trans
&trans  &kp END         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans                                     &trans     &trans           &trans       &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &none           &desk_left      &desk_right      &none                 &none        &none   &trans     &trans           &trans       &trans  &trans  &trans
                                                        &trans           &mo LAYER_MOUSE_SLOW  &mkp LCLK    &trans  &mkp LCLK  &mkp RCLK
            >;
        };

        // Entered automatically by touching the right trackpad (see
        // nickey44a_r.overlay) and for a moment after a click key. Only the
        // thumb keys change, so shortcuts such as Cmd+C keep working right
        // after using the trackpad.
        AUTO_MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                     &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                     &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &none        &none   &trans     &trans     &trans  &trans  &trans  &trans
                                &trans  &mo LAYER_MOUSE_SLOW  &mkp LCLK    &trans  &mkp LCLK  &mkp RCLK
            >;
        };
    };
};
